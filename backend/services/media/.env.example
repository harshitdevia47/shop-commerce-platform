NODE_ENV=development
LOG_LEVEL=debug
PORT=4004
DATABASE_URL=postgresql://qc:qc_dev_password@localhost:5433/qc_media
INTERNAL_HMAC_SECRET=dev-only-internal-secret-change-me-0123456789
# Files are written to <MEDIA_ROOT>/public/<shopId>/... (nginx serves public/ at /media in production)
MEDIA_ROOT=../../uploads
# URL prefix returned to clients for public files
MEDIA_PUBLIC_PATH=/media
# Dev only: also serve public files from this service at /media (the gateway proxies /media here)
MEDIA_SERVE_STATIC=true
TENANT_URL=http://localhost:4001
