NODE_ENV=development
LOG_LEVEL=debug
PORT=4011
DATABASE_URL=postgresql://qc:qc_dev_password@localhost:5433/qc_platform
REDIS_URL=redis://localhost:6380
# Must be identical in every service. Generate: openssl rand -hex 32
INTERNAL_HMAC_SECRET=dev-only-internal-secret-change-me-0123456789
# Who may log in (comma separated). Codes are emailed to these addresses only.
ADMIN_EMAILS=admin@example.com
# The address the admin site is opened at (checked on every form submit).
ADMIN_ORIGIN=http://localhost:4011
# openssl rand -hex 32
LOGIN_CODE_SECRET=dev-only-login-code-secret-change-me-0123456789
# console = print emails in the log (dev); gmail = send through Gmail with an app password
MAIL_PROVIDER=console
# MAIL_USER=you@gmail.com
# MAIL_APP_PASSWORD_FILE=/run/mail/gmail-app-password
# MAIL_TO=you@gmail.com
TENANT_URL=http://localhost:4001
IDENTITY_URL=http://localhost:4002
CATALOG_URL=http://localhost:4003
REPORTING_URL=http://localhost:4010
# UPI ID shops pay the subscription to (shown to shop owners and in reminders)
# PLATFORM_UPI_ID=you@okaxis
# sha256 of the token the new-shop command uses (node scripts/platform-token.mjs)
# PLATFORM_API_TOKEN_HASH=
