NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
INTERNAL_HMAC_SECRET=dev-only-internal-secret-change-me-0123456789
REDIS_URL=redis://localhost:6380
# Generated by `npm run keys:dev` (run from backend/)
JWT_PUBLIC_KEY_FILE=../../.keys/jwt-public.pem
JWT_ISSUER=qc-identity
# Upstream services
TENANT_URL=http://localhost:4001
IDENTITY_URL=http://localhost:4002
# Requests per minute per client IP per shop
RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the gateway (nginx = 1)
TRUST_PROXY_HOPS=0
