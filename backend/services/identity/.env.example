NODE_ENV=development
LOG_LEVEL=debug
PORT=4002
DATABASE_URL=postgresql://qc:qc_dev_password@localhost:5433/qc_identity
REDIS_URL=redis://localhost:6380
INTERNAL_HMAC_SECRET=dev-only-internal-secret-change-me-0123456789
# Generated by `npm run keys:dev` (run from backend/)
JWT_PRIVATE_KEY_FILE=../../.keys/jwt-private.pem
JWT_ISSUER=qc-identity
# openssl rand -hex 32
OTP_SECRET=dev-only-otp-secret-change-me-0123456789abcdef
SMS_PROVIDER=console
# Dev only: return the OTP in the API response (refused when NODE_ENV=production)
OTP_DEV_ECHO=true
# For scripts/users.ts (create-owner)
TENANT_URL=http://localhost:4001
