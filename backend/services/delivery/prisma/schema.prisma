// Delivery service: the shop's riders deliver orders. Assignment, pickup, delivery OTP.
// The latest rider location lives in Redis only (short TTL), never in Postgres.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

/// One per order (reassigning changes the rider on the same row).
/// Order details are a snapshot taken at assignment, for the rider's screen.
model Delivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  shopId         String         @map("shop_id") @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  orderNumber    Int            @map("order_number")
  customerId     String         @map("customer_id") @db.Uuid
  customerName   String?        @map("customer_name")
  customerPhone  String         @map("customer_phone")
  /// Address snapshot (line1, landmark, city, pincode, lat/lng)
  address        Json
  note           String?
  itemCount      Int            @map("item_count")
  totalPaise     Int            @map("total_paise")
  /// Cash the rider collects (0 for prepaid/UPI orders)
  codPaise       Int            @map("cod_paise")
  riderId        String         @map("rider_id") @db.Uuid
  riderName      String?        @map("rider_name")
  riderPhone     String         @map("rider_phone")
  status         DeliveryStatus @default(ASSIGNED)
  /// 4-digit code the customer tells the rider at the door. Shown only to the customer.
  otp            String
  otpAttempts    Int            @default(0) @map("otp_attempts")
  assignedAt     DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  pickedUpAt     DateTime?      @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([shopId, orderId])
  @@index([shopId, riderId, status])
  @@map("deliveries")
}

/// Transactional outbox (see @qc/events). Published to Redis Streams and deleted by the relay.
model OutboxEvent {
  id        String   @id @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  type      String
  stream    String
  envelope  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("outbox_events")
}

/// Events this service already handled (consumer idempotency).
model ProcessedEvent {
  shopId      String   @map("shop_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([shopId, eventId])
  @@map("processed_events")
}
