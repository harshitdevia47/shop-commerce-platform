// Reporting service: sales read models built from order and payment events.
// Never the source of truth: everything here can be rebuilt by replaying the event streams.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// One row per order (from order.placed, updated by order.status_changed).
model SaleOrder {
  orderId       String    @map("order_id") @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  number        Int
  customerId    String    @map("customer_id") @db.Uuid
  placedAt      DateTime  @map("placed_at") @db.Timestamptz(3)
  /// Shop calendar day (IST) the order was placed: reports group by it.
  placedDay     DateTime  @map("placed_day") @db.Date
  fulfillment   String
  paymentMethod String    @map("payment_method")
  totalPaise    Int       @map("total_paise")
  itemCount     Int       @map("item_count")
  isListOrder   Boolean   @default(false) @map("is_list_order")
  /// Latest order status.
  status        String
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)

  items SaleItem[]

  @@id([shopId, orderId])
  @@index([shopId, placedDay])
  @@index([shopId, customerId, placedAt])
  @@map("sale_orders")
}

/// Order lines (orders placed with Phase 7+ events carry them).
model SaleItem {
  shopId         String   @map("shop_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productName    String   @map("product_name")
  variantLabel   String   @map("variant_label")
  qty            Int
  lineTotalPaise Int      @map("line_total_paise")
  placedDay      DateTime @map("placed_day") @db.Date

  order SaleOrder @relation(fields: [shopId, orderId], references: [shopId, orderId], onDelete: Cascade, onUpdate: Restrict)

  @@id([shopId, orderId, variantId])
  @@index([shopId, placedDay])
  @@map("sale_items")
}

/// Orders marked paid (payment stream). Separate table: payment and order events may arrive in any order.
model SalePayment {
  shopId  String   @map("shop_id") @db.Uuid
  orderId String   @map("order_id") @db.Uuid
  paidAt  DateTime @map("paid_at") @db.Timestamptz(3)

  @@id([shopId, orderId])
  @@map("sale_payments")
}

/// Events this service already handled (consumer idempotency).
model ProcessedEvent {
  shopId      String   @map("shop_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([shopId, eventId])
  @@map("processed_events")
}
