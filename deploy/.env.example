# Copy to deploy/.env on the server. Never commit the real file.
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_USER=qc
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32  (same value for every service)
INTERNAL_HMAC_SECRET=change-me-to-64-hex-characters-change-me-to-64-hex-characters00
JWT_ISSUER=qc-identity
# openssl rand -hex 32
OTP_SECRET=change-me-to-64-hex-characters-change-me-to-64-hex-characters00
# Real provider required in production (console is refused): msg91 with a DLT-approved template
SMS_PROVIDER=console
# MSG91_OTP_TEMPLATE_ID=<flow template id from the MSG91 panel>
# MSG91_OTP_VARIABLE=otp
# MSG91_AUTH_KEY_FILE=/run/sms/msg91-auth-key
OTP_DEV_ECHO=false
RATE_LIMIT_PER_MINUTE=120
# Push notifications: console (logs only) until Firebase is set up, then fcm with
# deploy/secrets/fcm/service-account.json and FCM_SERVICE_ACCOUNT_FILE=/run/fcm/service-account.json
PUSH_PROVIDER=console
# FCM_SERVICE_ACCOUNT_FILE=/run/fcm/service-account.json
# Off-site backups (scripts/backup.sh): an rclone remote, e.g. b2:qc-backups
# RCLONE_REMOTE=
# Build at most 2 images at a time (8 GB servers run out of memory otherwise)
COMPOSE_PARALLEL_LIMIT=2
