# Copy to deploy/.env on the server. Never commit the real file.
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_USER=qc
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32  (same value for every service)
INTERNAL_HMAC_SECRET=change-me-to-64-hex-characters-change-me-to-64-hex-characters00
JWT_ISSUER=qc-identity
# openssl rand -hex 32
OTP_SECRET=change-me-to-64-hex-characters-change-me-to-64-hex-characters00
# Login codes. Production refuses console. whatsapp = WhatsApp Cloud API (no DLT); msg91 = SMS (DLT)
SMS_PROVIDER=console
# WHATSAPP_PHONE_NUMBER_ID=<from Meta app → WhatsApp → API setup>
# WHATSAPP_OTP_TEMPLATE=login_code
# WHATSAPP_ACCESS_TOKEN_FILE=/run/sms/whatsapp-token
# MSG91_OTP_TEMPLATE_ID=<flow template id from the MSG91 panel>
# MSG91_OTP_VARIABLE=otp
# MSG91_AUTH_KEY_FILE=/run/sms/msg91-auth-key
OTP_DEV_ECHO=false
RATE_LIMIT_PER_MINUTE=120
# Push notifications: console (logs only) until Firebase is set up, then fcm with
# deploy/secrets/fcm/service-account.json and FCM_SERVICE_ACCOUNT_FILE=/run/fcm/service-account.json
PUSH_PROVIDER=console
# FCM_SERVICE_ACCOUNT_FILE=/run/fcm/service-account.json
# Off-site backups (scripts/backup.sh): an rclone remote, e.g. b2:qc-backups
# RCLONE_REMOTE=

# Privacy policy and terms (/legal/<slug>/privacy|terms): the business that runs the apps.
# Missing values show as "[... not set]" on the pages.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CITY=
LEGAL_EFFECTIVE_DATE=2026-12-01

# Shop Admin app server (docs/deploy.md, 6e). Overdue alerts use PUSH_PROVIDER / FCM_SERVICE_ACCOUNT_FILE above.
# Until the admin phone registers for notifications they come by email (MAIL_*).
# Who may log in (comma separated); login codes are emailed to these addresses only.
ADMIN_EMAILS=you@gmail.com
# openssl rand -hex 32
LOGIN_CODE_SECRET=change-me-to-64-hex-characters-change-me-to-64-hex-characters00
# gmail = send with a Gmail app password (file below); console = log only (refused in production)
MAIL_PROVIDER=gmail
MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD_FILE=/run/mail/gmail-app-password
# UPI ID shops pay you to, and the usual monthly fee (₹) prefilled on the admin site
PLATFORM_UPI_ID=you@okaxis
PLATFORM_DEFAULT_FEE_RUPEES=999
# node backend/scripts/platform-token.mjs (the token itself goes in backend/.env.platform on the laptop)
# PLATFORM_API_TOKEN_HASH=
